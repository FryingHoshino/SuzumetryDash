<Window x:Class="Suzumetry.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suzumetry HUD" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" WindowStartupLocation="Manual"
        FontFamily="Bahnschrift, Segoe UI" Foreground="#F2F4F8" UseLayoutRounding="True">
    <Border x:Name="Root" Background="#D00B0D11" CornerRadius="12" Padding="12" BorderThickness="2" BorderBrush="Transparent">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel Width="340">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GearT" Text="N" FontSize="58" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SpeedT" Text="0" FontSize="38" FontWeight="SemiBold"/>
                        <TextBlock Text="km/h" FontSize="12" Foreground="#7F8798" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <TextBlock x:Name="RpmT" FontSize="12" Foreground="#7F8798"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="56">
                    <TextBlock x:Name="PosT" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="StateT" FontSize="12" Foreground="#FFB020" HorizontalAlignment="Right"/>
                    <Rectangle x:Name="FlagR" Height="6" RadiusX="3" RadiusY="3" Fill="Transparent" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Height="10" Margin="0,6,0,8">
                <Rectangle Fill="#2A2F3A" RadiusX="5" RadiusY="5"/>
                <Rectangle x:Name="RpmFill" Fill="#5CFF8A" RadiusX="5" RadiusY="5" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="RpmS" ScaleX="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="PedalP" Orientation="Horizontal" Margin="0,0,10,0">
                    <Grid Width="12" Height="56" Margin="0,0,4,0">
                        <Rectangle Fill="#2A2F3A" RadiusX="3" RadiusY="3"/>
                        <Rectangle Fill="#4DA6FF" RadiusX="3" RadiusY="3" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="CltS" ScaleY="0"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <Grid Width="12" Height="56" Margin="0,0,4,0">
                        <Rectangle Fill="#2A2F3A" RadiusX="3" RadiusY="3"/>
                        <Rectangle Fill="#FF5A5A" RadiusX="3" RadiusY="3" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="BrkS" ScaleY="0"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <Grid Width="12" Height="56">
                        <Rectangle Fill="#2A2F3A" RadiusX="3" RadiusY="3"/>
                        <Rectangle Fill="#5CFF8A" RadiusX="3" RadiusY="3" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="ThrS" ScaleY="0"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </StackPanel>
                <UniformGrid x:Name="TyreP" Grid.Column="1" Columns="2" Width="96" Margin="0,0,10,0">
                    <TextBlock x:Name="T0" Text="--" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="T1" Text="--" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="T2" Text="--" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="T3" Text="--" FontSize="16" FontWeight="SemiBold"/>
                </UniformGrid>
                <StackPanel x:Name="LapP" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="CurT" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="LastT" FontSize="12" Foreground="#7F8798" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BestT" FontSize="12" Foreground="#FF5A7A" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="FuelT" FontSize="12" Foreground="#7F8798" Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
