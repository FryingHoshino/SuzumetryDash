<Window x:Class="Suzumetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SuzumetryDash" Width="1040" Height="720" MinWidth="920" MinHeight="640"
        Background="#0E0F13" Foreground="#E8EAF0" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Background" Value="#2A2D38"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A3E4D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF5A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20232D"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#343846"/>
            <Setter Property="CaretBrush" Value="#E8EAF0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#262A36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF5A7A"/>
            <Setter Property="Maximum" Value="1"/>
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF5A7A"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A90A2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="2.3*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#171920" CornerRadius="12" Padding="22">
            <StackPanel>
                <Grid>
                    <TextBlock Text="SUZUMETRY" FontSize="22" FontWeight="Bold" Foreground="#FF5A7A" Margin="0,-14,0,15"/>
                        <TextBlock Text="ShizuDash" FontSize="22" FontWeight="Bold" Foreground="#FFFF9797" Margin="37,0,-37,0" FontStyle="Italic"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="Spinner" Width="16" Height="16" Stroke="#FF5A7A" StrokeThickness="2.5" StrokeDashArray="5 12" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0" Visibility="Collapsed">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinRot"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="GameText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#8A90A2"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="CarText" Margin="0,10,0,0" FontSize="16"/>
                <TextBlock x:Name="TrackText" Style="{StaticResource Dim}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GearText" Text="N" FontSize="120" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SpeedText" Text="0" FontSize="64" FontWeight="SemiBold"/>
                            <TextBlock Text="km/h" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="8,0,0,14"/>
                        </StackPanel>
                        <TextBlock x:Name="RpmText" Style="{StaticResource Dim}"/>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="RpmBar" Margin="0,6,0,16" Height="14"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Throttle" Style="{StaticResource Dim}"/>
                        <ProgressBar x:Name="ThrBar" Foreground="#5CFF8A"/>
                    </StackPanel>
                    <StackPanel Margin="4,0">
                        <TextBlock Text="Brake" Style="{StaticResource Dim}"/>
                        <ProgressBar x:Name="BrkBar" Foreground="#FF5A5A"/>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Clutch" Style="{StaticResource Dim}"/>
                        <ProgressBar x:Name="CltBar" Foreground="#4DA6FF"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Current" Style="{StaticResource Dim}"/>
                        <TextBlock x:Name="CurText" Text="--:--.---" FontSize="22" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Last" Style="{StaticResource Dim}"/>
                        <TextBlock x:Name="LastText" Text="--:--.---" FontSize="22" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Best" Style="{StaticResource Dim}"/>
                        <TextBlock x:Name="BestText" Text="--:--.---" FontSize="22" FontFamily="Consolas" Foreground="#FF5A7A"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="InfoText" Margin="0,18,0,0" FontSize="14"/>
                <TextBlock Text="Tyres (FL FR RL RR)" Style="{StaticResource Dim}" Margin="0,18,0,6"/>
                <UniformGrid Columns="2">
                    <TextBlock x:Name="Tyre0" FontFamily="Consolas" FontSize="16"/>
                    <TextBlock x:Name="Tyre1" FontFamily="Consolas" FontSize="16"/>
                    <TextBlock x:Name="Tyre2" FontFamily="Consolas" FontSize="16"/>
                    <TextBlock x:Name="Tyre3" FontFamily="Consolas" FontSize="16"/>
                </UniformGrid>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Background="#171920" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Phone stream" Style="{StaticResource H}" Margin="0,0,0,6"/>
                    <ListBox x:Name="UrlList" Background="#20232D" Foreground="#E8EAF0" BorderThickness="0" MaxHeight="110"/>
                    <TextBlock Text="Click a link to copy it" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PortBox"/>
                        <Button x:Name="PortBtn" Grid.Column="1" Content="Apply port" Margin="6,0,0,0"/>
                        <Button x:Name="FwBtn" Grid.Column="2" Content="Open firewall" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="ServerText" Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ClientsText" Style="{StaticResource Dim}"/>

                    <TextBlock Text="Telemetry" Style="{StaticResource H}"/>
                    <TextBlock x:Name="ReadLabel" Style="{StaticResource Dim}"/>
                    <Slider x:Name="ReadSlider" Minimum="30" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="StreamLabel" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                    <Slider x:Name="StreamSlider" Minimum="10" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="Game" Style="{StaticResource Dim}" Margin="0,8,0,4"/>
                    <ComboBox x:Name="GameCombo">
                        <ComboBoxItem Content="Auto detect"/>
                        <ComboBoxItem Content="Assetto Corsa"/>
                        <ComboBoxItem Content="Assetto Corsa Competizione"/>
                        <ComboBoxItem Content="DiRT Rally 2.0"/>
                    </ComboBox>

                    <TextBlock Text="DiRT Rally 2.0" Style="{StaticResource H}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Dr2PortBox"/>
                        <Button x:Name="Dr2Btn" Grid.Column="1" Content="Enable UDP in game config" Margin="6,0,0,0"/>
                    </Grid>

                    <TextBlock Text="HUD" Style="{StaticResource H}"/>
                    <CheckBox x:Name="HudCheck" Content="Show HUD over game"/>
                    <CheckBox x:Name="HudLockCheck" Content="Unlock to move (drag the HUD)"/>
                    <TextBlock Text="Ctrl+Alt+H show or hide · Ctrl+Alt+L unlock or lock" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                    <TextBlock Text="Scale" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                    <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="Opacity" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <CheckBox x:Name="ChkPedals" Content="Pedals" Margin="0,10,0,0"/>
                    <CheckBox x:Name="ChkTyres" Content="Tyres"/>
                    <CheckBox x:Name="ChkLaps" Content="Lap times"/>
                    <CheckBox x:Name="ChkFuel" Content="Fuel"/>
                    <TextBlock Text="The HUD needs the game in borderless or windowed mode." Style="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="AuthorBtn" Content="Author" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
    <Grid x:Name="AuthorLayer" Visibility="Collapsed">
        <Rectangle x:Name="AuthorShade" Fill="#99000000" Opacity="0"/>
        <Border x:Name="AuthorCard" Width="350" Height="350" CornerRadius="26" Background="#171920" BorderBrush="#2A2F3A" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardMove"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="260" Height="260">
                    <Rectangle x:Name="AuthorImg" RadiusX="38" RadiusY="38" Fill="#FF5A7A"/>
                    <TextBlock x:Name="AuthorInitial" FontSize="34" FontWeight="Bold" Foreground="#0E0F13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="AuthorName" Grid.Row="1" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Grid>
</Window>
